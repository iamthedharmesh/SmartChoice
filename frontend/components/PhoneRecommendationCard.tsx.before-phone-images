import Link from "next/link";
import { PhoneRecommendation } from "@/lib/api";

type Props = {
  phone: PhoneRecommendation;
};

export default function PhoneRecommendationCard({ phone }: Props) {
  const formatINR = (v: number | null) => {
    if (v === null || v === undefined) return null;
    return new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0,
    }).format(v);
  };

  const priceLabel = formatINR(phone.price_inr);
  const match = Number(phone.match_percentage) || 0;
  const enrichment = phone.enrichment;

  return (
    <Link
      href={`/mobile/${phone.phone_id}`}
      className="group block rounded-xl border border-border-subtle bg-bg-card overflow-hidden transition-all duration-300 hover:border-border-glow hover:bg-bg-card-hover card-glow"
      aria-label={`View ${phone.brand} ${phone.model}`}
    >
      <div className="flex flex-col sm:flex-row">
       <div className="relative w-full sm:w-32 shrink-0 aspect-[3/4] sm:aspect-auto sm:h-full min-h-[170px] bg-gradient-to-b from-bg-deep to-bg-card border-b sm:border-b-0 sm:border-r border-border-subtle flex flex-col items-center justify-center gap-2 px-3 text-center overflow-hidden">
  {enrichment?.official_image_url ? (
    <img
      src={enrichment.official_image_url}
      alt={`${phone.brand} ${phone.model}`}
      className="h-32 w-full object-contain transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
  ) : (
    <div className="relative">
      <svg
        className="w-10 h-10 text-accent-gold/80"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z" />
      </svg>

      <div
        className="absolute inset-0 rounded-md bg-accent-gold/5 blur-lg -z-10"
        aria-hidden="true"
      />
    </div>
  )}

   <span className="text-[10px] uppercase tracking-wider text-text-muted font-medium">
    {phone.brand}
  </span>
</div>

        <div className="flex-1 p-4">
          <div className="flex items-start justify-between gap-2">
            <div className="min-w-0">
              <p className="text-xs font-semibold uppercase tracking-wider text-text-muted">
                {phone.brand}
              </p>

              <h3 className="line-clamp-2 text-sm font-semibold text-text-primary group-hover:text-accent-gold transition-colors">
                {phone.model}
              </h3>
            </div>

            {phone.has_5g && (
              <span className="shrink-0 text-[10px] font-semibold px-2 py-0.5 rounded-full bg-accent-gold/15 border border-accent-gold/30 text-accent-gold">
                5G
              </span>
            )}
          </div>

          {/* Match */}
          <div className="mt-3">
            <div className="flex items-center justify-between gap-2">
              <span className="text-[10px] font-semibold uppercase tracking-[0.15em] text-text-muted">
                SmartChoice Match
              </span>

              <span className="text-lg font-bold text-accent-gold">
                {match.toFixed(1)}%
              </span>
            </div>

            <div className="mt-1.5 h-1.5 w-full rounded-full bg-border-subtle overflow-hidden">
              <div
                className="h-full bg-gradient-to-r from-accent-gold to-accent-gold-dim transition-all duration-500"
                style={{
                  width: `${Math.min(Math.max(match, 0), 100)}%`,
                }}
              />
            </div>
          </div>

          {/* Basic specs */}
          <div className="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-text-secondary">
            {phone.rating !== null && phone.rating !== undefined && (
              <span className="inline-flex items-center gap-1">
                <svg
                  className="w-3 h-3 fill-current text-amber-400"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l6.88-1.01L12 2z" />
                </svg>
                {phone.rating.toFixed(1)}
              </span>
            )}

            {phone.ram_gb !== null && phone.ram_gb !== undefined && (
              <span>{phone.ram_gb} GB RAM</span>
            )}

            {phone.storage_gb !== null && phone.storage_gb !== undefined && (
              <span>{phone.storage_gb} GB</span>
            )}

            {phone.battery_mah !== null && phone.battery_mah !== undefined && (
              <span>{phone.battery_mah} mAh</span>
            )}

            {phone.refresh_rate_hz !== null &&
              phone.refresh_rate_hz !== undefined && (
                <span>{phone.refresh_rate_hz} Hz</span>
              )}
          </div>

          {/* Processor + price */}
          <div className="mt-2 flex items-center justify-between gap-2">
            <div className="min-w-0">
              {phone.processor_brand && (
                <p className="truncate text-xs text-text-muted capitalize">
                  {phone.processor_brand}
                </p>
              )}
            </div>

            {priceLabel && (
              <span className="shrink-0 text-sm font-semibold text-accent-gold">
                {priceLabel}
              </span>
            )}
          </div>

          {/* Enriched verified specifications */}
          {enrichment && (
            <div className="mt-3 border-t border-border-subtle pt-3">
              <div className="flex items-center justify-between mb-2">
                <p className="text-[10px] font-semibold uppercase tracking-wider text-text-muted">
                  Verified Specs
                </p>

                {enrichment.model_id && (
                  <span className="text-[9px] text-text-muted">
                    {enrichment.model_id}
                  </span>
                )}
              </div>

              <div className="grid grid-cols-2 gap-1.5 sm:grid-cols-3">
                {enrichment.display_type && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    Display: {enrichment.display_type}
                  </span>
                )}

                {enrichment.display_refresh_rate_hz && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.display_refresh_rate_hz} Hz
                  </span>
                )}

                {enrichment.rear_main_mp && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.rear_main_mp} MP Main
                  </span>
                )}

                {enrichment.rear_main_ois &&
                  ["yes", "true", "1"].includes(
                    String(enrichment.rear_main_ois).toLowerCase()
                  ) && (
                    <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                      OIS Camera
                    </span>
                  )}

                {enrichment.wired_charging_w && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.wired_charging_w}W Charging
                  </span>
                )}

                {enrichment.ip_rating && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.ip_rating}
                  </span>
                )}

                {enrichment.weight_g && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.weight_g}g
                  </span>
                )}

                {enrichment.wifi_standard && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    {enrichment.wifi_standard}
                  </span>
                )}

                {enrichment.usb_version && (
                  <span className="rounded-md border border-border-subtle bg-bg-deep px-2 py-1 text-[10px] text-text-secondary">
                    USB {enrichment.usb_version}
                  </span>
                )}
              </div>
            </div>
          )}

          {/* Why this phone */}
          {phone.reasons && phone.reasons.length > 0 && (
            <div className="mt-3 border-t border-border-subtle pt-2">
              <p className="text-[10px] font-semibold uppercase tracking-wider text-text-muted mb-1">
                Why this phone?
              </p>

              <div className="flex flex-wrap gap-1">
                {phone.reasons.slice(0, 3).map((reason, idx) => (
                  <span
                    key={idx}
                    className="text-[10px] px-2 py-0.5 rounded-full bg-bg-deep text-text-muted border border-border-subtle"
                  >
                    {reason}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </Link>
  );
}